<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="250dp"
        android:layout_height="380dp"
        app:cardCornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:src="@drawable/gamesicon"
                android:layout_marginTop="88dp"/>

            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_below="@id/icon"
                android:id="@+id/button_quiz"
                android:layout_marginTop="42dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Quiz"
                android:textAllCaps="false"
                android:background="@drawable/buttonpurple"
                android:fontFamily="@font/berlinlight"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="28sp"/>

            <Button
                android:textColor="@color/colorPrimaryDark"
                style="?android:attr/borderlessButtonStyle"
                android:id="@+id/button_mixcolor"
                android:layout_below="@id/button_quiz"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Mix Colors"
                android:textAllCaps="false"
                android:background="@drawable/buttonpurple"
                android:fontFamily="@font/berlinlight"
                android:textSize="22sp"/>

            <Button
                android:layout_width="171dp"
                android:layout_height="60dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="38dp"
                android:layout_marginBottom="284dp"
                android:background="@drawable/buttonpurple"
                android:clickable="false"
                android:fontFamily="@font/berlinlight"
                android:text="games"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="22sp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ImageButton
        android:elevation="@dimen/cardview_default_elevation"
        android:id="@+id/button_xgames"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="345dp"
        android:background="@drawable/buttonforexitpopup"
        android:src="@drawable/closepopup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardView3"
        app:layout_constraintVertical_bias="0.0" />


</androidx.constraintlayout.widget.ConstraintLayout>